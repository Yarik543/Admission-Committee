@model AdmissionCommittee.Domain.Entities.Applicant

@{
    ViewData["Title"] = "Удалить абитуриента";
}

<div class="container mt-4">
    <h2>@ViewData["Title"]</h2>
    <h3>Вы уверены, что хотите удалить абитуриента?</h3>

    <div>
        <dl class="row">
            <dt class="col-sm-2">ФИО</dt>
            <dd class="col-sm-10">@Model.FullName</dd>

            <dt class="col-sm-2">Пол</dt>
            <dd class="col-sm-10">@Model.Gender</dd>

            <dt class="col-sm-2">Дата рождения</dt>
            <dd class="col-sm-10">@Model.BirthDate.ToString("dd.MM.yyyy")</dd>

            <dt class="col-sm-2">Форма обучения</dt>
            <dd class="col-sm-10">@Model.EduForm</dd>
        </dl>

        <form asp-action="Delete" method="post">
            <input type="hidden" asp-for="Id" />
            @Html.AntiForgeryToken()

            <button type="submit" class="btn btn-danger">Удалить</button>
            <a asp-action="Index" class="btn btn-secondary">Отмена</a>
        </form>
    </div>
</div>