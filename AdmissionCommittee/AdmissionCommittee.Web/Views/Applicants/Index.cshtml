@model IEnumerable<AdmissionCommittee.Domain.Entities.Applicant>

@{
    ViewData["Title"] = "Справочник абитуриентов";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

<div class="container mt-4">
    <h2>@ViewData["Title"]</h2>

    <div class="mb-3">
        <a asp-action="Create" class="btn btn-success">Добавить абитуриента</a>
        <a asp-action="Index" class="btn btn-primary">Обновить</a>
    </div>

    <div class="mb-3">
        <span class="me-3">Всего абитуриентов: <strong>@ViewBag.Total</strong></span>
        <span>Прошли (сумма > 150): <strong>@ViewBag.Passed</strong></span>
    </div>

    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>ФИО</th>
                <th>Пол</th>
                <th>Дата рождения</th>
                <th>Форма обучения</th>
                <th>Математика</th>
                <th>Русский</th>
                <th>Информатика</th>
                <th>Сумма баллов</th>
                <th>Действия</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var applicant in Model)
            {
                <tr>
                    <td>@applicant.FullName</td>
                    <td>@applicant.Gender</td>
                    <td>@applicant.BirthDate.ToString("dd.MM.yyyy")</td>
                    <td>@applicant.EduForm</td>
                    <td>@applicant.MathScore</td>
                    <td>@applicant.RusScore</td>
                    <td>@applicant.ITScore</td>
                    <td>@(applicant.MathScore + applicant.RusScore + applicant.ITScore)</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@applicant.Id" class="btn btn-sm btn-warning">Редактировать</a>
                        <button type="button" class="btn btn-sm btn-danger" data-bs-toggle="modal" data-bs-target="#deleteModal"
                                data-id="@applicant.Id" data-name="@applicant.FullName">
                            Удалить
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Modal удаления -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="deleteForm" method="post" asp-action="DeleteConfirmed">
                <div class="modal-header">
                    <h5 class="modal-title" id="deleteModalLabel">Подтвердите удаление</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button>
                </div>
                <div class="modal-body">
                    <p>Вы уверены, что хотите удалить абитуриента <strong id="applicantName"></strong>?</p>
                    <input type="hidden" id="applicantId" name="id" value="" />
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-danger">Удалить</button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Отмена</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        var deleteModal = document.getElementById('deleteModal')
        deleteModal.addEventListener('show.bs.modal', function (event) {
            var button = event.relatedTarget
            var id = button.getAttribute('data-id')
            var name = button.getAttribute('data-name')

            var modalTitle = deleteModal.querySelector('.modal-title')
            var modalBodyName = deleteModal.querySelector('#applicantName')
            var modalInputId = deleteModal.querySelector('#applicantId')

            modalBodyName.textContent = name
            modalInputId.value = id
        })
    </script>
}