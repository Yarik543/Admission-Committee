<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>

		<Authors>Kasymbekov_Yaroslav</Authors>
		<Product>AdmissionCommittee In-Memory Storage</Product>
		<Description>In-memory repository implementation for AdmissionCommittee.</Description>
		<Version>1.0.0</Version>
		<PackageTags>datagridview;repository;inmemory;education</PackageTags>

		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageIcon>icon.png</PackageIcon>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\AdmissionCommittee.Abstractions\AdmissionCommittee.Abstractions.csproj" />
		<ProjectReference Include="..\AdmissionCommittee.Domain\AdmissionCommittee.Domain.csproj" />

		<None Include="README.md" Pack="true" PackagePath="" />
		<None Include="icon.png" Pack="true" PackagePath="" />
	</ItemGroup>

</Project>